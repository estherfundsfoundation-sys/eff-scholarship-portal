{
  "manifest_version": 3,
  "name": "EFF Apply Agent",
  "version": "0.1.0",
  "description": "Student-controlled autofill for verified college and scholarship application pages.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["https://*/*"],
  "action": {"default_popup": "popup.html", "default_title": "EFF Apply Agent"},
  "background": {"service_worker": "background.js"},
  "content_scripts": [{"matches": ["https://*/*"], "js": ["content.js"], "run_at": "document_idle"}]
}
