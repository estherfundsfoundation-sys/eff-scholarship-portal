# Ask EFF is additive and server-side. Keep provider keys out of NEXT_PUBLIC_*.
ASK_EFF_ENABLED=false
ASK_EFF_WEB_SEARCH_ENABLED=false
ASK_EFF_SAVED_HISTORY_ENABLED=false
ASK_EFF_PILOT_ONLY=true
ASK_EFF_PILOT_ACCESS_CODE=replace-with-a-private-pilot-code
ASK_EFF_MOCK_MODE=false
OPENAI_API_KEY=server-only-openai-key
ASK_EFF_MODEL=gpt-5.6-luna
ASK_EFF_MODERATION_MODEL=omni-moderation-latest
ASK_EFF_RATE_LIMIT_SECRET=generate-a-separate-long-random-secret
ASK_EFF_REQUESTS_PER_USER_PER_DAY=25
ASK_EFF_DAILY_BUDGET_USD=25
ASK_EFF_ESTIMATED_REQUEST_COST_USD=0.04
ASK_EFF_MAX_INPUT_CHARACTERS=5000
ASK_EFF_MAX_OUTPUT_TOKENS=900
ASK_EFF_MAX_MESSAGES=16
ASK_EFF_TEMPORARY_RETENTION_MINUTES=60
STAFF_LOGIN_AUDIT_SECRET=generate-a-separate-random-secret-of-at-least-32-characters
